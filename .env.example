# ----------------- FastAPI -----------------
# Порт и хост для запуска приложения
API_TITLE=example
API_DESCRIPTION=example
API_VERSION=1.0.0
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True

# ----------------- PostgreSQL -----------------
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=adboard-fastapi
DB_HOST=adboard-postgres
DB_PORT=5432

# ----------------- Redis -----------------
REDIS_URL=redis://adboard-redis:6379/0

# ----------------- RabbitMQ (taskiq) -----------------
RABBITMQ_URL=amqp://guest:guest@adboard-rabbitmq:5672/

# ----------------- JWT / Auth -----------------
# Пример секретного ключа для FastAPI JWT
SECRET_KEY=supersecretkey
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAY=7

# ----------------- Email (если есть) -----------------
EMAIL_SERVER=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=example@example.com
EMAIL_PASSWORD=supersecretpassword
EMAIL_FROM=example@example.com
EMAIL_FROM_NAME=example@example.com